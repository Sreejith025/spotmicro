# SpotMicro Robot Agent Configuration (Raspberry Pi 5 Software Connection)
# Set these environment variables on the Raspberry Pi or local test environment.
# DO NOT commit real secrets or tokens to source control.

# Web backend URL (Render production URL or local development server)
SPOTMICRO_BACKEND_URL=https://spotmicro-backend.onrender.com

# Operator API Bearer token for authenticating with the backend
SPOTMICRO_OPERATOR_API_TOKEN=

# Software Watchdog timeout in seconds (transitions to SAFE_IDLE / STOP if stale)
SPOTMICRO_WATCHDOG_TIMEOUT_S=5.0

# Heartbeat ping interval in seconds
SPOTMICRO_HEARTBEAT_INTERVAL_S=2.0

